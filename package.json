{
	"name": "obsidian-jekyll-exporter",
	"version": "2.0.0",
	"private": true,
	"description": "A plugin to export Obsidian notes to Jekyll blog posts",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"version": "node scripts/sync-version.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"jekyll",
		"blog",
		"export"
	],
	"author": "Fred-Ko",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Fred-Ko/obsidian-jekyll-exporter.git"
	},
	"bugs": {
		"url": "https://github.com/Fred-Ko/obsidian-jekyll-exporter/issues"
	},
	"homepage": "https://github.com/Fred-Ko/obsidian-jekyll-exporter#readme",
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.1",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.28.1",
		"eslint": "^10.7.0",
		"globals": "^17.7.0",
		"obsidian": "1.13.1",
		"prettier": "^3.9.6",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"nanoid": "^6.0.0",
		"yaml": "^2.9.0"
	},
	"volta": {
		"node": "22.12.0"
	}
}
